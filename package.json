{
  "name": "car-ball",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "find . -type d -name dist -prune -exec rm -rf {} + && find . -type f -name '*.tsbuildinfo' -delete",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "echo \"lint placeholder\"",
    "benchmark": "node --experimental-strip-types scripts/benchmark_harness.ts",
    "slo:gates": "node --experimental-strip-types scripts/evaluate_slo_gates.ts --sample-if-empty",
    "soak:check": "node --experimental-strip-types scripts/soak_release_check.ts"
  },
  "devDependencies": {
    "@types/node": "^22.14.1",
    "typescript": "^5.8.2"
  }
}
