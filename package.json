{
  "name": "car-ball",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "npm run clean:dist && npm run clean:tsbuildinfo && npm run clean:node_modules",
    "clean:dist": "find . -type d -name dist -prune -exec rm -rf {} +",
    "clean:tsbuildinfo": "find . -type f -name '*.tsbuildinfo' -delete",
    "clean:node_modules": "find . -type d -name node_modules -prune -exec rm -rf {} +",
    "dev": "concurrently --names server,client \"npm --workspace @car-ball/server run dev\" \"npm --workspace @car-ball/client run dev\"",
    "start": "concurrently --names server,client \"npm --workspace @car-ball/server run start\" \"npm --workspace @car-ball/client run start\"",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "echo \"lint placeholder\"",
    "benchmark": "node --experimental-strip-types scripts/benchmark_harness.ts",
    "slo:gates": "node --experimental-strip-types scripts/evaluate_slo_gates.ts --sample-if-empty",
    "soak:check": "node --experimental-strip-types scripts/soak_release_check.ts"
  },
  "devDependencies": {
    "@types/node": "^22.14.1",
    "concurrently": "^9.2.1",
    "typescript": "^5.8.2",
    "vite": "^6.2.0"
  }
}
